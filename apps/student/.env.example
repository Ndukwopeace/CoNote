# Copy to .env.local to change settings. Never commit .env files (.gitignore blocks them).

# Where the app gets its data: "mock" (seeded demo data) or "supabase".
VITE_DATA_SOURCE=mock

# Needed only when VITE_DATA_SOURCE=supabase. Must be an https URL.
# SECURITY: VITE_ variables are bundled into the public JavaScript, so only the public anon key
# belongs here. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
